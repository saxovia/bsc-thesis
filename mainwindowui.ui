QMainWindow, #scrollArea_2 {
	background: #111;
}
QLabel, QWidget {
	color: #EEE;
	background-color: transparent;
}

#title_frame {
	background-color: #2d2b36;
}

#main_frame,
#mainframe QWidget {
	background-color: #181621;
}

QScrollArea {
	background-color: transparent;
	border: none;
}


QScrollBar:vertical, QScrollBar:horizontal {
	background-color: transparent;
	width: 8px;
	height: 8px;
	border-radius: 5px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
	background-color: #494dca;
	border-radius: 5px;
	width: 15px;
}

