QMainWindow, #scrollArea_2 {
	background: #111;
}
QLabel, QWidget {
	color: #EEE;
	background-color: transparent;
	outline: none;
}

#title_frame {
	background-color: #2d2b36;
}

#main_frame,
#mainframe QWidget {
	background-color: #181621;
}

QScrollArea {
	background-color: transparent;
	border: none;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 14px;
    height: 14px;
    margin: 2px;
	border-radius: 3px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #494dca;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #6562d1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollArea QWidget {
	background-color: transparent;
}




#title_frame QLabel {
	color: #fff;
	background-color: transparent;
}

QPushButton {
	font-size: 12px;
}

QPushButton:pressed {
	background-color: #494dca;
}
QPushButton:disabled {
	color: rgb(94, 90, 113);
	background-color: 2d2b36;
}

#timeline_page .QPushButton,
#model_page .QPushButton,
#choose_results_page .QPushButton,
#side_widget .QPushButton,
#model_pruning_table_page .QPushButton,
#settings_page .QPushButton{
	background-color: #44424c;
	color: #fff;

}
#timeline_page .QPushButton,
#choose_results_page .QPushButton,
#side_widget .QPushButton,
#model_pruning_table_page .QPushButton,
#settings_page .QPushButton{
	min-width: 200px;
	max-width: 200px;
	min-height: 40px;
	max-height: 40px;
	border-radius: 15px;
}
#model_train_button, #modify_timeline_button{
	min-width: 150px;
	max-width: 200px;
	min-height: 40px;
	max-height: 40px;
	border-radius: 15px;
}
#undo_button, #save_process_button{
	min-width: 40px;
	max-width: 40px;
	min-height: 40px;
	max-height:40px;
	border-radius: 15px;
}


QCheckBox {
    spacing: 8px;
    background-color: transparent;
    color: white;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid white;
    border-radius: 6px;  /* Rounded corners */
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: white;
}


#home_page .QPushButton {
	color: #fff;
	font-size: 16px;
	border-radius: 10px;
	border-width: 1px;
	border-style: solid;
	border-color: #EEE;
	min-width: 300px;
	max-width: 300px;
	min-height: 55px;
	max-height: 55px;
}

#main_frame .QPushButton:hover {
	background-color: #6562d1;
}

#statusbar {
	background-color: #6562d1;
	color: #fff;
	font-size: 12px;
	padding-left: 20px;
	padding-right: 20px;
	padding-top: 5px;
	padding-bottom: 5px;
}

#side_widget .QPushButton {
	min-height: 40px;
	max-height: 40px;
	max-width: 150px;
	min-width: 150px;
}

#side_widget {
	background-color: #2d2b36;
}

#icon_label {
	min-width: 30px;
	max-width: 30px;
	min-height: 30px;
	max-height: 30px;
	border-radius: 15px;
}


#title_frame QPushButton {
	border: none;
	width: 25px;
	height: 15px;
}

#maximize_button:hover,
#minimize_button:hover {
	background-color: #6562d1;
}

#close_button:hover {
	background-color: #c42b1c;
}

QComboBox {
	color: #fff;
	background-color: #2d2b36;
	border-radius: 5px;
	border-color: transparent;
	padding: 5px;
	background-color: #2d2b36;
}

QMessageBox {
	background-color: #35314F;
	color: white;
	border-color: transparent;
	border-width: 0px;
	border-radius: 10px;
	font-size: 14px;
	text-align: center;

}

QMessageBox QLabel {
	margin: 30px;
	margin-right: 40px;
	margin-top: 40px;
	padding-right: 30px;
}

QMessageBox QPushButton {
	background-color: #5F5A71;
	color: white;
	border-radius: 10px;
	padding: 8px;
	font-size: 12px;
	padding-left: 13px;
	padding-right: 13px;
}

QMessageBox QPushButton:hover {
	background-color: #6562d1;
}

QGroupBox {
	color: #fff;
	border-color: transparent;
	border-width: 0px;
	font-size: 16px;
}

QTextEdit,
QPlainTextEdit, QLineEdit {
	min-height: 30px;
	color: #fff;
	background-color: #2d2b36;
	border-radius: 5px;
	border-color: transparent;
}



#main_widget {
	border-image: url(./resources/mainwindow.png) 0 0 0 0 stretch stretch;
	background-repeat: no-repeat;
	background-position: center;
}

#side_widget {
	background-image: url(./resources/sidewidget.png)
}

#timeline_main_content_frame{
	background-color: #181621;
	border-radius:15px;

}
QListWidget {
    border: none;
    background: transparent;
    padding: 10px;
 outline: none;
    text-align: center;
}

QListWidget::item {
    border-radius: 10px;
    padding: 10px;
    margin: 5px; /* Spacing between buttons */
    text-align: center;
    font-weight: bold;
	color: #fff;
	font-size: 16px;
	border-width: 1px;
	border-style: solid;
	border-color: #EEE;
	min-width: 150px;
	max-width: 150px;
	min-height: 25px;
	max-height: 25px;
}

QListWidget::item:selected {
    background: #6562d1; /* Highlight color */
    color: white;
    font-weight: bold;
}
QTableWidget, QTableView {
    background-color: #1c1b21;
    border: 2px solid #444;
    border-radius: 10px;
    gridline-color: #1c1b21;
    color: #f0f0f0;
    font-size: 13px;
    selection-background-color: #3d6cad;
    selection-color: white;
    padding: 4px;
    outline: none;
}

QTableWidget::item, QTableView::item {
    border: none;
    padding: 10px;
    background-color: #1c1b21;
}



QTableWidget QTableCornerButton::section, QTableView QTableCornerButton::section {
    background-color: #2d2b36;
    border: none;
}

QTableWidget QHeaderView::section, 
QTableView QHeaderView::section {
    background-color: #2b2b2b;
    color: #dcdcdc;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #444;
    font-weight: bold;
}

QTableWidget QTableView::item, 
QTableView::item {
      border: none;
    padding: 6px;
}

QTableWidget::horizontalHeader, QTableWidget::verticalHeader, QTableView::horizontalHeader, QTableView::verticalHeader {
    background-color: #e5e5e5;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color:#4c4b70 ;
    color: #ffffff;
}

QTableWidget, QTableView {
    border-collapse: collapse;
    margin-top: 10px;
	color: #DDD;			
}</string>
