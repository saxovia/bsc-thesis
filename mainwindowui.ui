QListWidget {
    border: none;
    background: transparent;
    padding: 10px;
 outline: none;
    text-align: center;
}

QListWidget::item {
    background: #44424c;
    border-radius: 10px;
    padding: 10px;
    margin: 5px; /* Spacing between buttons */
    text-align: center;
    font-weight: bold;
}

QListWidget::item:selected {
    background: #6562d1; /* Highlight color */
    color: white;
    font-weight: bold;
}

QTableWidget, QTableView {
    border: 1px solid #181621;  /* Border around the entire table */
    border-radius: 10px;  /* Round the corners of the table */
    padding: 5px;
    background-color: #181621;
outline: none;
}

QTableWidget::item, QTableView::item {
    border: none;  /* No border for each item */
    padding: 10px;
    background-color: #2d2b36;
}



QTableWidget QTableCornerButton::section, QTableView QTableCornerButton::section {
    background-color: #2d2b36;
    border: none;
}

QTableWidget QHeaderView::section, 
QTableView QHeaderView::section {
    background-color: #2d2b36;
    border: 1px solid #181621;
    padding: 10px;
    font-weight: bold;
}

QTableWidget QTableView::item, 
QTableView::item {
    border-bottom: 1px solid #ddd;  /* Bottom border for rows */
}

QTableWidget::horizontalHeader, QTableWidget::verticalHeader, QTableView::horizontalHeader, QTableView::verticalHeader {
    background-color: #e5e5e5;
    border: none;
}



QTableWidget, QTableView {
    border-collapse: collapse;
    margin-top: 10px;
	color: #DDD;			
}
