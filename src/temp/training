
import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import datasets, transforms
from torch.utils.data import DataLoader

class MLP(nn.Module):
    def __init__(self, input_size, hidden_size, output_size):
        super(MLP, self).__init__()
        self.fc1 = nn.Linear(input_size, hidden_size)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(hidden_size, output_size)

    def forward(self, x):
        x = self.fc1(x)
        x = self.relu(x)
        x = self.fc2(x)
        return x

class LSTMModel(nn.Module):
    def __init__(self, input_size, hidden_size, output_size, num_layers=1):
        super(LSTMModel, self).__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
        self.fc = nn.Linear(hidden_size, output_size)

    def forward(self, x):
        h0 = torch.zeros(1, x.size(0), self.hidden_size).to(x.device)
        c0 = torch.zeros(1, x.size(0), self.hidden_size).to(x.device)
        out, _ = self.lstm(x, (h0, c0))
        out = self.fc(out[:, -1, :])
        return out
def create_model(model_type, input_size, hidden_size, output_size):
    if model_type == "mlp":
        return MLP(input_size, hidden_size, output_size)
    elif model_type == "lstm":
        return LSTMModel(input_size, hidden_size, output_size)
    else:
        raise ValueError("Invalid model type. Choose 'mlp' or 'lstm'.")

def train_sparse_model(prior, pruning_method, dataset="MNIST", pruning_rate=0.5):
    """
    Train a sparse model with the selected network prior and pruning method.

    prior: instance of NetworkPrior
    pruning_method: instance of PruningMethod
    """
    sparse_structure = prior.generate()
    model = create_neural_network(sparse_structure)
    model = pruning_method.prune(model, pruning_rate)

    accuracy = train_and_evaluate(model, dataset)
    print(f"Final accuracy: {accuracy:.2f}%")

    return model


def train_and_evaluate(model_type="mlp", dataset="MNIST", optimizer_name="adam", lr=0.001, epochs=10, batch_size=32, device="cuda" if torch.cuda.is_available() else "cpu"):
    """
    Train and evaluate a sparse neural network using PyTorch.
    
    model: PyTorch neural network model
    dataset: The dataset to train on ("MNIST" supported here)
    optimizer_name: Name of the optimizer (e.g., "adam", "sgd", "rmsprop")
    lr: Learning rate for the optimizer
    epochs: Number of training epochs
    batch_size: Batch size for training
    device: "cuda" if available, otherwise "cpu"
    """


    # Load dataset (modify as needed for other datasets)
    transform = transforms.Compose([transforms.ToTensor(), transforms.Normalize((0.1307,), (0.3081,))])
    
    train_loader = DataLoader(datasets.MNIST(root='./data', train=True, download=True, transform=transform), batch_size=batch_size, shuffle=True)
    test_loader = DataLoader(datasets.MNIST(root='./data', train=False, download=True, transform=transform), batch_size=batch_size, shuffle=False)

    input_size = 28 * 28  # MNIST images are 28x28
    hidden_size = 128
    output_size = 10
    
    model = create_model(model_type, input_size, hidden_size, output_size)
    model.to(device)

    # Define loss function
    criterion = nn.CrossEntropyLoss()

    # Select optimizer
    optimizers = {
        "adam": optim.Adam(model.parameters(), lr=lr),
        "sgd": optim.SGD(model.parameters(), lr=lr, momentum=0.9),
        "rmsprop": optim.RMSprop(model.parameters(), lr=lr),
        "adagrad": optim.Adagrad(model.parameters(), lr=lr)
    }

    optimizer = optimizers.get(optimizer_name.lower(), optim.Adam(model.parameters(), lr=lr))  # Default to Adam

    # Training loop
    model.train()
    for epoch in range(epochs):
        total_loss = 0
        correct = 0
        total = 0

        for inputs, targets in train_loader:
            inputs, targets = inputs.to(device), targets.to(device)

            optimizer.zero_grad()
            outputs = model(inputs.view(inputs.shape[0], -1))  # Flatten input for MLP
            loss = criterion(outputs, targets)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            correct += (outputs.argmax(dim=1) == targets).sum().item()
            total += targets.size(0)

        train_accuracy = 100 * correct / total
        print(f"Epoch {epoch+1}/{epochs}, Loss: {total_loss/len(train_loader):.4f}, Train Accuracy: {train_accuracy:.2f}%")

    # Evaluation loop
    model.eval()
    correct = 0
    total = 0
    with torch.no_grad():
        for inputs, targets in test_loader:
            inputs, targets = inputs.to(device), targets.to(device)
            outputs = model(inputs.view(inputs.shape[0], -1))  # Flatten input for MLP
            correct += (outputs.argmax(dim=1) == targets).sum().item()
            total += targets.size(0)

    test_accuracy = 100 * correct / total
    print(f"Test Accuracy: {test_accuracy:.2f}%")

    return test_accuracy
