import networkx as nx
import torch
import torch.nn as nn
import numpy as np

def generate_ws_graph(num_nodes, k, p):
    """Generates a Watts-Strogatz graph adjacency matrix."""
    ws_graph = nx.watts_strogatz_graph(num_nodes, k, p)
    adj_matrix = nx.to_numpy_array(ws_graph)
    return torch.tensor(adj_matrix, dtype=torch.float32)

# Define layer sizes (as per your original MLP)
layer_sizes = [89, 44, 22, 11, 4, 80]

class SparseMLPLayer(nn.Module):
    def __init__(self, in_features, out_features, adj_matrix):
        super(SparseMLPLayer, self).__init__()
        self.adj_matrix = adj_matrix  # Connectivity pattern
        self.weights = nn.Parameter(torch.randn(in_features, out_features) * 0.1)
        self.bias = nn.Parameter(torch.zeros(out_features))
        
    def forward(self, x):
        # Apply graph mask: Remove connections that don't exist in the WS graph
        masked_weights = self.weights * self.adj_matrix
        return torch.relu(x @ masked_weights + self.bias)
class WS_MLP(nn.Module):
    def __init__(self, layer_sizes, k=4, p=0.2):
        super(WS_MLP, self).__init__()
        self.layers = nn.ModuleList()
        
        for i in range(len(layer_sizes) - 1):
            # Generate WS Graph for each layer
            adj_matrix = generate_ws_graph(layer_sizes[i], k, p)
            self.layers.append(SparseMLPLayer(layer_sizes[i], layer_sizes[i+1], adj_matrix))

    def forward(self, x):
        for layer in self.layers:
            x = layer(x)
        return x

# Instantiate WS-MLP
ws_mlp = WS_MLP(layer_sizes)
print(ws_mlp)
class SparseLSTM(nn.Module):
    def __init__(self, input_size, hidden_size, num_layers, k=4, p=0.2):
        super(SparseLSTM, self).__init__()
        self.num_layers = num_layers
        self.hidden_size = hidden_size
        
        # Generate adjacency matrices for each LSTM layer
        self.adj_matrices = [generate_ws_graph(hidden_size, k, p) for _ in range(num_layers)]
        
        # Define standard LSTM
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
    
    def forward(self, x):
        # Forward pass through the LSTM
        out, (hn, cn) = self.lstm(x)
        
        # Apply graph mask to hidden states (prune weights)
        for i in range(self.num_layers):
            hn[i] = hn[i] * self.adj_matrices[i]  # Keep only WS connections
        
        return out

# Instantiate WS-LSTM
ws_lstm = SparseLSTM(input_size=16, hidden_size=16, num_layers=3)
