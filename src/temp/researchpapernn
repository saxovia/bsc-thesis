class LSTMLayer(nn.Module):
    def __init__(self, input_size, hidden_size):
        super(LSTMLayer, self).__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, batch_first=True)

    def forward(self, x):
        # Assuming x is of shape (batch_size, seq_len, input_size)
        out, _ = self.lstm(x)
        return out
def create_lstm_networks(dag, layer_assignment):
    lstm_networks = {}
    layer_inputs = {}  # Stores the input size for each layer
    layer_nodes = {}   # Stores the number of nodes in each layer

    # Initialize storage
    for node, layer in layer_assignment.items():
        if layer not in layer_inputs:
            layer_inputs[layer] = 0
            layer_nodes[layer] = 0
        
        layer_nodes[layer] += 1  # Count how many nodes are in each layer

    # Compute input sizes correctly
    for node, layer in layer_assignment.items():
        predecessors = list(dag.predecessors(node))
        
        # Sum hidden sizes of previous layers for input
        input_size = sum(layer_nodes[layer_assignment[pred]] for pred in predecessors if layer_assignment[pred] in layer_nodes) if predecessors else 1
        layer_inputs[layer] = max(layer_inputs[layer], input_size)  # Avoid redundant summing
    
    # Create LSTMs for each layer
    for layer in sorted(layer_inputs.keys()):
        input_size = layer_inputs[layer]
        hidden_size = layer_nodes[layer]  # Correct hidden size
        
        lstm_networks[layer] = LSTMLayer(input_size, hidden_size)
        
        print(f"Layer {layer}: Input Size = {input_size}, Hidden Size = {hidden_size}")

    return lstm_networks

# Generate LSTMs with the corrected logic
