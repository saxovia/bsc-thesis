# to get the DAG, make a function that takes an undirected graph and set the lower triangular adjacency matrix of the new graph. diagonal entries and upper triangular matrix are set to zero of the final graph
def undirtodag(G):
    adj_matrix = nx.to_numpy_array(G)
    n = adj_matrix.shape[0]
    dag = nx.DiGraph()
    dag.add_nodes_from(G.nodes)
    for i in range(n):
        for j in range(i): #ensures that the lower triangular matrix is used
            if adj_matrix[i][j] > 0: #checks if there is an edge between i and j
                dag.add_edge(i,j)

    return dag

